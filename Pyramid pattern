#include <iostream>
using namespace std;

int main(){
    int n;
    cout<<"Enter Number of Lines:";
    cin>>n;

    for(int i = 1; i <= n; i++){

        // correct spaces
        for(int j = 1; j <= n - i; j++){
            cout<<" ";
        }

     // stars
        for(int k = 1; k <= 2*i - 1; k++){
            cout<<"*";
        }

        cout<<endl;
    }

    return 0;
}
 
